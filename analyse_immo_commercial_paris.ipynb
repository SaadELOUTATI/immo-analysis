    "dispo = df[df['statut'] == 'Disponible'].copy()\n",
    "\n",
    "# Score normalisé : flux élevé = bon, prix élevé = mauvais\n",
    "dispo['score_flux'] = (dispo['flux_pietons_jour'] - dispo['flux_pietons_jour'].min()) / \\\n",
    "                      (dispo['flux_pietons_jour'].max() - dispo['flux_pietons_jour'].min())\n",
    "dispo['score_prix'] = 1 - (dispo['prix_m2_an'] - dispo['prix_m2_an'].min()) / \\\n",
    "                          (dispo['prix_m2_an'].max() - dispo['prix_m2_an'].min())\n",
    "dispo['score_final'] = (dispo['score_flux'] * 0.6 + dispo['score_prix'] * 0.4).round(3)\n",
    "\n",
    "top5 = dispo.nlargest(5, 'score_final')[[\n",
    "    'arrondissement', 'type_commerce', 'surface_m2',\n",
    "    'prix_m2_an', 'flux_pietons_jour', 'score_final'\n",
    "]].reset_index(drop=True)\n",
    "\n",
    "top5.index += 1\n",
    "print('🏆 Top 5 emplacements disponibles (score flux/prix)')\n",
    "top5"
