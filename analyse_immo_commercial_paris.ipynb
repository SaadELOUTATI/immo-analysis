   "source": [
    "fig, ax = plt.subplots()\n",
    "\n",
    "colors = {'Disponible': '#2563eb', 'Loué': '#dc2626', 'En négociation': '#f59e0b'}\n",
    "for statut, group in df.groupby('statut'):\n",
    "    ax.scatter(group['flux_pietons_jour'], group['prix_m2_an'],\n",
    "               label=statut, alpha=0.6, s=40, color=colors[statut])\n",
    "\n",
    "# Ligne de tendance\n",
    "z = np.polyfit(df['flux_pietons_jour'], df['prix_m2_an'], 1)\n",
    "p = np.poly1d(z)\n",
    "x_line = np.linspace(df['flux_pietons_jour'].min(), df['flux_pietons_jour'].max(), 100)\n",
    "ax.plot(x_line, p(x_line), 'k--', alpha=0.4, linewidth=1.5, label='Tendance')\n",
    "\n",
    "ax.set_title('🚶 Flux piétons vs Prix au m²', fontsize=14, fontweight='bold', pad=15)\n",
    "ax.set_xlabel('Flux piétons / jour')\n",
