   "source": [
    "np.random.seed(42)\n",
    "n = 200\n",
    "\n",
    "arrondissements = [\n",
    "    '75001', '75002', '75003', '75004', '75005',\n",
    "    '75006', '75007', '75008', '75009', '75010',\n",
    "    '75011', '75012', '75013', '75014', '75015',\n",
    "    '75016', '75017', '75018', '75019', '75020'\n",
    "]\n",
    "\n",
    "# Prix au m² médian par arrondissement (loyer €/m²/an)\n",
    "prix_base = {\n",
    "    '75001': 850, '75002': 780, '75003': 700, '75004': 760, '75005': 650,\n",
    "    '75006': 820, '75007': 780, '75008': 900, '75009': 680, '75010': 520,\n",
    "    '75011': 480, '75012': 420, '75013': 400, '75014': 410, '75015': 430,\n",
    "    '75016': 600, '75017': 560, '75018': 390, '75019': 320, '75020': 300\n",
    "}\n",
    "\n",
    "types_commerce = ['Restauration', 'Retail', 'Services', 'Bureaux', 'Santé']\n",
    "statuts = ['Disponible', 'Loué', 'En négociation']\n",
    "\n",
    "arr_choix = np.random.choice(arrondissements, n)\n",
    "surfaces = np.random.randint(30, 500, n)\n",
    "prix_m2 = np.array([prix_base[a] * np.random.uniform(0.8, 1.2) for a in arr_choix])\n",
    "loyer_annuel = (surfaces * prix_m2).astype(int)\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    'arrondissement': arr_choix,\n",
    "    'type_commerce': np.random.choice(types_commerce, n),\n",
    "    'surface_m2': surfaces,\n",
    "    'prix_m2_an': prix_m2.round(0),\n",
    "    'loyer_annuel_eur': loyer_annuel,\n",
    "    'statut': np.random.choice(statuts, n, p=[0.4, 0.45, 0.15]),\n",
    "    'flux_pietons_jour': np.random.randint(500, 15000, n)\n",
    "})\n",
    "\n",
    "print(f'✅ Dataset créé : {len(df)} locaux commerciaux')\n",
    "df.head()"
   ]
  },
